# ---------- مرحلة البناء ----------
FROM python:3.12-slim AS builder

WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# ---------- مرحلة التشغيل ----------
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends libpq5 curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r coesis && useradd -r -g coesis -d /app coesis

WORKDIR /app
COPY --from=builder /root/.local /home/coesis/.local
COPY --chown=coesis:coesis . .
# مجلد فارغ مملوك لـ coesis حتى تُنسخ صلاحياته إلى الـ named volume (ai_model_store)
# عند أول تشغيل - Docker ينسخ محتوى/صلاحيات مسار الصورة إلى volume فارغ يُركَّب عليه.
RUN mkdir -p /app/model_store && chown coesis:coesis /app/model_store

ENV PATH=/home/coesis/.local/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

USER coesis

EXPOSE 8000

# ملاحظة: healthcheck الفعلي مضبوط في docker-compose.prod.yml بصيغة CMD-SHELL الصحيحة
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--proxy-headers"]
